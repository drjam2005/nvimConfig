highlight clear
set background=dark
syntax reset
let g:colors_name = "tty16"

highlight Normal       ctermfg=7 ctermbg=1
highlight Comment      ctermfg=2
highlight Constant     ctermfg=5
highlight Identifier   ctermfg=4
highlight Statement    ctermfg=6
highlight PreProc      ctermfg=3
highlight Type         ctermfg=1
highlight Special      ctermfg=6
highlight Error        ctermfg=15 ctermbg=1
highlight Todo         ctermfg=0 ctermbg=3

